---
/**
 * Bildplatz für echte Fotos.
 * Mit `src` (lokaler Import aus src/assets/fotos) rendert die Komponente ein
 * optimiertes <picture> mit AVIF und WebP, Breiten-Set, width/height und
 * Lazy Loading. Ohne `src` erscheint ein beschrifteter Platzhalter.
 * Bitte keine KI-generierten oder Stock-Fotos einsetzen.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src?: ImageMetadata;
  alt: string;
  motiv: string;           // Beschreibung für den Platzhalter
  format: string;          // z. B. "3:2 quer"
  ratio: string;           // CSS aspect-ratio, z. B. "3 / 2"
  sizes?: string;
  eager?: boolean;         // nur für das erste sichtbare Bild
  dunkel?: boolean;        // Platzhalter auf dunklem Grund
  class?: string;
}

const {
  src, alt, motiv, format, ratio,
  sizes = '(min-width: 60em) 50vw, 100vw',
  eager = false, dunkel = false, class: className,
} = Astro.props;

const ratioClass = `r-${ratio.replace(/\s|\//g, '')}`;
---
{src ? (
  <Picture
    src={src}
    alt={alt}
    formats={['avif', 'webp']}
    widths={[480, 800, 1200, 1600, 2000].filter((w) => w <= src.width)}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding="async"
    class:list={['foto', ratioClass, className]}
  />
) : (
  <div class:list={['bildplatz', ratioClass, { 'bildplatz--dunkel': dunkel }, className]}>
    <p>
      <span class="ph">[PLATZHALTER: Foto]</span>
      <span class="bildplatz__motiv">{motiv}</span>
      <span class="bildplatz__format">Format {format}, mindestens 2000 px breit</span>
    </p>
  </div>
)}

<style>
  .foto, .bildplatz { width: 100%; }
  .foto { height: auto; object-fit: cover; background: var(--papier-2); }
  .r-32 { aspect-ratio: 3 / 2; }
  .r-43 { aspect-ratio: 4 / 3; }
  .r-45 { aspect-ratio: 4 / 5; }
  .r-169 { aspect-ratio: 16 / 9; }
  .r-11 { aspect-ratio: 1 / 1; }

  .bildplatz {
    display: grid;
    place-items: end start;
    padding: var(--s-5);
    background:
      linear-gradient(var(--papier-line), var(--papier-line)) 0 0 / 100% 1px no-repeat,
      repeating-linear-gradient(135deg, transparent 0 14px, rgb(30 34 38 / 0.05) 14px 15px),
      var(--papier-2);
    color: var(--graphit);
  }
  .bildplatz--dunkel {
    background:
      repeating-linear-gradient(135deg, transparent 0 14px, rgb(243 240 234 / 0.06) 14px 15px),
      var(--graphit-2);
    color: var(--papier);
  }
  .bildplatz p { display: grid; gap: var(--s-2); justify-items: start; font-size: var(--fs-s); line-height: 1.4; }
  .bildplatz__motiv { font-weight: 600; }
  .bildplatz__format { opacity: 0.8; }
</style>
