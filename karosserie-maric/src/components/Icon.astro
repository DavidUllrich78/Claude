---
/** Eigene, schlichte Linien-Icons. Immer dekorativ (aria-hidden), Text steht daneben. */
interface Props {
  name: 'telefon' | 'pfeil' | 'kamera' | 'stern' | 'karte' | 'mail' | 'uhr';
  class?: string;
}
const { name, class: className } = Astro.props;
---
<svg class={className} viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"
  fill={name === 'stern' ? 'currentColor' : 'none'} stroke={name === 'stern' ? 'none' : 'currentColor'}
  stroke-width="2" stroke-linecap="square" stroke-linejoin="miter">
  {name === 'telefon' && (
    <path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A17 17 0 0 1 3 5a2 2 0 0 1 2-2z" />
  )}
  {name === 'pfeil' && <path d="M4 12h15M13 6l6 6-6 6" />}
  {name === 'kamera' && (
    <>
      <path d="M3 8h4l2-3h6l2 3h4v11H3z" />
      <circle cx="12" cy="13" r="3.5" />
    </>
  )}
  {name === 'stern' && <path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z" />}
  {name === 'karte' && (
    <>
      <path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z" />
      <circle cx="12" cy="9.5" r="2.5" />
    </>
  )}
  {name === 'mail' && (
    <>
      <path d="M3 5h18v14H3z" />
      <path d="M3 6l9 7 9-7" />
    </>
  )}
  {name === 'uhr' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M12 7v5l3 2" />
    </>
  )}
</svg>
